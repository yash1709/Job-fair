# Copy to .env and fill in. Every key is optional - the keyless sources work without any of them.
# 1. API key: https://console.cloud.google.com/apis/credentials  (enable "Custom Search API")
GOOGLE_API_KEY=
# 2. Search engine ID (cx): https://programmablesearchengine.google.com  -> "Search the entire web"
GOOGLE_CSE_ID=

# Optional, free, cover India (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country used for Adzuna when the location isn't Indian: in, gb, us, de, au, ca, sg, ...
ADZUNA_COUNTRY=in
# Optional, free (https://jooble.org/api/about)
JOOBLE_API_KEY=

# Optional, free: India jobs checked at employer sources, 50 calls/day (https://www.jobvetta.com)
JOBVETTA_API_KEY=

# Optional: Google Jobs via SerpApi (https://serpapi.com). Free plan = 100 searches/MONTH.
SERPAPI_API_KEY=

# Optional tuning (defaults shown). Daily caps per metered source, reset at UTC midnight:
# GOOGLE_DAILY_LIMIT=100
# ADZUNA_DAILY_LIMIT=250
# JOOBLE_DAILY_LIMIT=500
# JOBVETTA_DAILY_LIMIT=50
# SERPAPI_DAILY_LIMIT=3
# Max searches per minute (app-wide) before paid sources are skipped
# MAX_SEARCHES_PER_MINUTE=20
# Set to 1 on a ~1GB host (e.g. Streamlit Community Cloud) to cap per-board job counts
# LOW_MEMORY=1
# Set to 1 to run the Flask app in debug mode
# JOB_SCRAPER_DEBUG=1
