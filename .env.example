# Copy to .env and fill in.
# 1. API key: https://console.cloud.google.com/apis/credentials  (enable "Custom Search API")
GOOGLE_API_KEY=
# 2. Search engine ID (cx): https://programmablesearchengine.google.com  -> "Search the entire web"
GOOGLE_CSE_ID=

# Optional, free, cover India (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country used for Adzuna when the location isn't Indian: in, gb, us, de, au, ca, sg, ...
ADZUNA_COUNTRY=in
# Optional, free (https://jooble.org/api/about)
JOOBLE_API_KEY=

# Optional, free: India jobs checked at employer sources, 50 calls/day (https://www.jobvetta.com)
JOBVETTA_API_KEY=
